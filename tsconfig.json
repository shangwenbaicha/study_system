{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@study/domain/*": ["packages/domain/src/*"],
      "@study/common-engines/*": ["packages/common-engines/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "services/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ]
}
