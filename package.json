{
  "name": "study-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch services/api/src/server.ts",
    "dev:web": "npm --workspace @study/web run dev",
    "build": "npm run build:api && npm --workspace @study/web run build",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "concurrently \"npm:start:api\" \"npm:start:web\"",
    "start:api": "node dist/services/api/src/server.js",
    "start:web": "npm --workspace @study/web run preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "prisma": "^6.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@types/pdfkit": "^0.17.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pdfkit": "^0.18.0",
    "zod": "^4.1.12"
  }
}
