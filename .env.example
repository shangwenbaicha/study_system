# ============================================================
# 日语学习独立站 — 环境变量配置
# ============================================================

# === 数据库 ===
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/study_system?schema=public"

# === JWT 认证 ===
JWT_SECRET=your-jwt-secret-change-in-production

# === 翻译服务 ===
# 当前使用 LibreTranslate（免费，可自托管）
# 可选值: libretranslate | deepseek | dummy
TRANSLATION_PROVIDER=libretranslate
# DeepSeek 备用（切换时只需改 PROVIDER + 填 Key）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 文件上传 ===
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# === SMTP 邮件服务 ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@xxxlangstudy.com

# === 前端 ===
VITE_API_BASE_URL=http://localhost:3000

# === 部署 ===
NODE_ENV=development
CORS_ORIGIN=*
PORT=3000
